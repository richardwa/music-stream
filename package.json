{
  "name": "music-streamer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier -w *.json *.ts ./src",
    "prebuild": "npm run format",
    "build": "tsc && vite build",
    "postbuild": "git rev-parse --short HEAD > dist/version.txt",
    "start": "tsx src/server/server.ts"
  },
  "devDependencies": {
    "@types/express": "types/express",
    "@types/node": "^25.5.2",
    "@types/tabulator-tables": "^6.3.1",
    "bun-types": "^1.3.11",
    "express": "^5.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "serve-index": "^1.9.2",
    "solid-vanilla": "github:richardwa/solid-vanilla",
    "tabulator-tables": "^6.4.0",
    "ts-node": "^10.9.2"
  }
}
